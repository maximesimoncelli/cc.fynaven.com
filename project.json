{
  "name": "cc.fynaven.com",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "prepare:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build.ts"
      },
      "inputs": [
        "{projectRoot}/src/content/packs/**/index.json",
        "{projectRoot}/wrangler.example.jsonc"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/src/content/packs/**/index.build.json",
        "{projectRoot}/wrangler.jsonc"
      ]
    },
    "astro:build": {
      "configurations": {
        "production": {}
      },
      "dependsOn": [
        "prepare:build",
        "wrangler:types",
        "astro:check",
        "eslint:lint",
        "prettier:format"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build"
      },
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "astro:preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview"
      }
    },
    "astro:dev": {
      "continuous": true,
      "dependsOn": ["wrangler:types"],
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev"
      }
    },
    "ci:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["astro:check", "eslint:lint", "prettier:format"],
      "options": {
        "commands": ["tsc -p tsconfig.json --noEmit"]
      },
      "cache": true
    },
    "full:check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "wrangler:types",
        "astro:check",
        "eslint:lint",
        "prettier:format"
      ],
      "options": {
        "commands": ["tsc -p tsconfig.json --noEmit"]
      },
      "cache": true
    },
    "wrangler:types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler types"
      },
      "outputs": ["{projectRoot}/./worker-configuration.d.ts"],
      "cache": true
    },
    "astro:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro check",
        "cwd": "{workspaceRoot}"
      },
      "cache": true
    },
    "eslint:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint ."
      },
      "cache": true
    },
    "prettier:format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier . --write"
      }
    },
    "wrangler:deploy": {
      "dependsOn": ["astro:build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy"
      }
    },
    "wrangler:version-upload": {
      "dependsOn": ["astro:build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm wrangler versions upload"
      }
    }
  }
}
