---
import { Check } from "@lucide/astro";
---

<label
  class="sticky top-15 z-10 flex cursor-pointer items-center gap-2 bg-olive-100 p-2 text-xs select-none dark:bg-mist-950"
  id="contrast-node"
  for="contrast"
>
  <input
    class="hidden"
    type="checkbox"
    name="contrast"
    alt="More contrast on transparent png pictures"
    id="contrast"
    checked
  />
  <div
    class="flex h-3.5 w-3.5 items-center rounded-sm bg-olive-200 dark:bg-mist-800"
  >
    <Check id="checkmark" class="text-olive-700 dark:text-olive-400" />
  </div>

  Apply more contrast to transparent pngs.
</label>

<script>
  document.addEventListener("astro:page-load", () => {
    const contrasterSetting =
      window.localStorage.getItem("contraster") ??
      window.localStorage.setItem("contraster", "show");

    const contrast = document.querySelector<HTMLInputElement>("#contrast");
    const checkmark = document.querySelector<HTMLElement>("#checkmark");
    const images = document.querySelectorAll(".image");

    if (contrast) {
      if (contrasterSetting === "show") {
        contrast.checked = true;
        for (let image of images) {
          image.classList.remove("bg-none!");
        }
        checkmark?.classList.remove("invisible");
      } else {
        contrast.checked = false;
        for (let image of images) {
          image.classList.add("bg-none!");
        }
        checkmark?.classList.add("invisible");
      }

      contrast.addEventListener("change", () => {
        if (contrast.checked) {
          window.localStorage.setItem("contraster", "show");
          for (let image of images) {
            image.classList.remove("bg-none!");
          }
          checkmark?.classList.remove("invisible");
        } else {
          window.localStorage.setItem("contraster", "hide");
          for (let image of images) {
            image.classList.add("bg-none!");
          }
          checkmark?.classList.add("invisible");
        }
      });
    }
  });
</script>
