---
import { Font, getImage } from "astro:assets";
import icon from "../assets/icon.jpg";
import socialSharing from "../assets/social-sharing.jpg";

const { title, socialSharingOverride } = Astro.props;

const socialSharingProcessed = await getImage({
  src: socialSharingOverride ?? socialSharing,
  width: 1178,
  height: 567,
  fit: "cover",
});
const iconProcessed = await getImage({
  src: icon,
});
---

<head>
  <Font cssVariable="--font-flegrei" preload />
  <Font cssVariable="--font-playfair" preload />
  <script>
    document.addEventListener("astro:page-load", () => {
      const storedTheme = localStorage.getItem("theme");
      if (
        storedTheme === "dark" ||
        (!storedTheme &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    });
  </script>
  <script is:inline>
    const storedTheme = localStorage.getItem("theme");
    if (
      storedTheme === "dark" ||
      (!storedTheme &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href={iconProcessed.src} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="generator" content={Astro.generator} />
  <meta property="og:image" content={socialSharingProcessed.src} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1178" />
  <meta property="og:image:height" content="567" />
  <meta
    property="description"
    content="Illustrations, textures, design elements and more, made available freely under the CC0 license. By Sylfvr."
  />
  <title>{title ? `${title} | CC0.FYNAVEN` : "CC0.FYNAVEN"}</title>
</head>
