---
interface Props {
  class?: string;
  id?: string;
  href: string;
  underline?: boolean;
}

const { underline, href, class: className, id: idx, ...rest } = Astro.props;
let target: "_blank" | undefined;

if (href.startsWith("https://")) {
  target = "_blank";
}
---

<!-- biome-ignore lint/a11y/useAnchorContent: <Biome doesn't understand slots yet?> -->
<a
  href={href}
  class:list={`text-olive-500 hover:text-olive-900 dark:text-olive-400 dark:hover:text-zinc-300 ${underline ? "underline" : ""} cursor-pointer font-semibold transition-colors duration-200 hover:underline ${className}`}
  id={idx}
  target={target}
  {...rest}><slot /></a
>
