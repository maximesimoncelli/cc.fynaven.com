---
import { Image } from "astro:assets";
import { getPacksSortedByDate } from "../../entities/images";
import Layout from "../../layouts/Layout.astro";

const allPacks = await getPacksSortedByDate();
---

<Layout title="Resource Packs">
  <div
    class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
    id="packs-grid"
  >
    {
      allPacks.map((pack) => {
        const { title, type, source, cover, publishedAt } = pack.data;

        return (
          <a href={`/packs/${pack.data.slug}`}>
            <article
              class="group relative flex flex-col overflow-hidden rounded-xs"
              id={`pack-card-${pack.id}`}
            >
              <div class="relative aspect-square w-full overflow-hidden">
                {
                  <Image
                    src={cover}
                    alt={title}
                    width={525}
                    height={525}
                    class="h-full w-full rounded-xs object-cover"
                  />
                }

                <span class="absolute top-4 right-4 border px-3 py-1 text-xs font-semibold tracking-wider text-zinc-300 uppercase">
                  {type}
                </span>
              </div>

              <div class="mt-4 flex grow flex-col justify-between">
                <div>
                  <h2 class="mb-2 text-xl font-bold">{title}</h2>
                  <p class="mb-4 line-clamp-2 text-xs text-zinc-500 italic">
                    Published: {publishedAt}
                  </p>
                  <p class="mb-4 line-clamp-2 text-xs text-zinc-500 italic">
                    Source: {source}
                  </p>
                </div>
              </div>
            </article>
          </a>
        );
      })
    }
  </div>
</Layout>
